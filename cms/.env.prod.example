# cms/.env.prod  — PRODUCTION database, for prod-targeting scripts ONLY.
#
# Copy this to `cms/.env.prod` and fill in the real prod values.
# `cms/.env.prod` is git-ignored (see .gitignore `cms/.env.*`) — never commit it.
#
# Used by the `:prod` npm scripts (they load THIS file via `node --env-file`):
#   pnpm migrate:status:prod   # show prod migration state (read-only)
#   pnpm migrate:prod          # apply pending migrations to prod
#
# Your normal local work uses cms/.env (the dev branch) — you never edit that to
# reach prod anymore; the `:prod` scripts read this file instead.
#
# IMPORTANT: use the DIRECT (non-pooled) Neon host — i.e. NO "-pooler" in the
# hostname — because schema DDL over the pgBouncer pooler can hang.
# DB_TARGET_HOST must equal the DATABASE_URI host exactly (the dbGuard checks it).

DATABASE_URI="postgresql://neondb_owner:<PASSWORD>@ep-jolly-firefly-as96kap9.c-4.eu-central-1.aws.neon.tech/neondb?sslmode=require"
DB_TARGET_HOST="ep-jolly-firefly-as96kap9.c-4.eu-central-1.aws.neon.tech"

# Transactional email (Resend) — the PRODUCTION values live in Vercel
# (`asecoroba-cms` → Production scope). Add them here too only if you need to
# exercise email flows locally against prod; the `:prod` scripts don't send mail.
RESEND_API_KEY=
EMAIL_DEFAULT_FROM_ADDRESS=no-reply@ase-cor-oba.site
EMAIL_DEFAULT_FROM_NAME=AseCorOba CMS
